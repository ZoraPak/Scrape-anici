# Salin file ini menjadi .env untuk development lokal
# Di Railway, isi variabel ini lewat dashboard → Variables

PORT=3000

# Redis — di Railway gunakan URL dari plugin Redis (otomatis terisi REDIS_URL)
REDIS_URL=redis://127.0.0.1:6379
# Atau pisah per field (REDIS_URL lebih prioritas jika ada):
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Secret untuk endpoint internal /api/internal/refresh
# Ganti dengan string random yang panjang
INTERNAL_SECRET=ganti-dengan-secret-random-panjang
